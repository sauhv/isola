{
  "name": "isola",
  "version": "0.0.1",
  "private": true,
  "description": "Isola - quản lý profile trình duyệt cô lập, local-first",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron \"next dev src/renderer -H 127.0.0.1 -p 3100\" \"wait-on http://127.0.0.1:3100 && cross-env ISOLA_DEV_URL=http://127.0.0.1:3100 electron-vite dev\"",
    "build": "next build src/renderer && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.7.0",
    "@puppeteer/browsers": "^3.2.3",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "lucide-react": "^1.52.0",
    "maxmind": "^5.0.7",
    "proxy-chain": "^3.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "electron-vite": "^5.0.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.25.12": true,
