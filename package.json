{
  "name": "isola",
  "version": "0.0.1",
  "private": true,
  "description": "Isola - quản lý profile trình duyệt cô lập, local-first",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron \"next dev src/renderer -H 127.0.0.1 -p 3100\" \"wait-on http://127.0.0.1:3100 && cross-env ISOLA_DEV_URL=http://127.0.0.1:3100 electron-vite dev\"",
    "build": "next build src/renderer && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/renderer/tsconfig.json",
    "postinstall": "node scripts/install-sqlite.mjs",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^32.3.3",
    "electron-vite": "^2.3.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "esbuild@0.21.5": true,
    "better-sqlite3@12.11.1": true
  }
}
